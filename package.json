{
  "name": "mz-3d-viewer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "WebGPU-first viewer and parsers for STL / OBJ / glTF / 3MF / STEP / IGES / BREP. Parsing and rendering happen entirely in the browser.",
  "license": "MIT",
  "author": "Miao Zhuang <mizy@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizy/mz-3d-viewer.git"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/write-sw.mjs",
    "preview": "vite preview --port 8901",
    "serve:dist": "node scripts/serve-dist.mjs",
    "verify": "node scripts/verify-site.mjs",
    "verify:tools": "node scripts/verify-viewer-tools.mjs",
    "verify:inspection": "node scripts/verify-inspection.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "icons": "python3 scripts/make-icons.py",
    "samples:3mf": "python3 scripts/make-3mf-samples.py",
    "build:pkg": "node scripts/build-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@storybook/html-vite": "10.6.8",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "occt-import-js": "^0.0.23",
    "playwright": "^1.63.0",
    "storybook": "10.6.8",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./occt/*": "./dist-lib/occt/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "three": "^0.186.0 || ^0.187.0"
  }
}
