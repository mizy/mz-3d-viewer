{
  "name": "mz-3d-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebGPU-first PWA viewer for STL / OBJ / glTF / STEP models. All parsing happens locally in the browser.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/write-sw.mjs",
    "preview": "vite preview --port 8901",
    "serve:dist": "node scripts/serve-dist.mjs",
    "verify": "node scripts/verify-site.mjs",
    "verify:tools": "node scripts/verify-viewer-tools.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "icons": "python3 scripts/make-icons.py",
    "samples:3mf": "python3 scripts/make-3mf-samples.py"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
